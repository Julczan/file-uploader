<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>JulczanDrive - Personal Cloud Storage</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
    <script
      src="https://kit.fontawesome.com/15a1a718f4.js"
      crossorigin="anonymous"
    ></script>
    <link rel="stylesheet" href="/styles.css" />
  </head>
  <body>
    <% if (locals.currentUser) { %>
    <div class="dashboard">
      <header class="topbar">
        <a href="/" class="logo"
          ><i class="fa-regular fa-cloud"></i> JulczanDrive</a
        >
        <div class="user-menu">
          <span class="greeting"
            >Welcome back, <strong><%= currentUser.username %></strong></span
          >
          <a href="/log-out" class="btn btn-outline">Log Out</a>
        </div>
      </header>

      <main class="dashboard-content">
        <aside class="sidebar">
          <%- include("partials/createFolder.ejs") %> <%-
          include("partials/uploadFile.ejs") %>
        </aside>

        <section class="main-stage">
          <%- include("partials/folderList.ejs") %> <%-
          include("partials/fileList.ejs") %>
        </section>
      </main>
    </div>

    <%- include("partials/errorDialog.ejs") %>

    <% } else { %>
    <div class="landing-container">
      <div class="landing-hero">
        <div class="hero-content">
          <h1>Perfectly organized files, kinda</h1>
          <p>Storage for your files, easy access, store the way you like.</p>
        </div>
      </div>

      <div class="landing-login"><%- include("partials/signUp.ejs") %></div>
    </div>
    <% } %>
  </body>
</html>
