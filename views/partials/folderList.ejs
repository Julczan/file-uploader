<div class="list-section">
  <h3 class="section-title">Folders</h3>

  <% if (locals.folders && folders.length !== 0) { %>
  <div class="folder-grid">
    <% folders.forEach((folder) => { %>
    <div class="folder-card">
      <a href="/folders/<%= folder.id %>" class="folder-link">
        <i class="fa-solid fa-folder"></i>
        <span class="folder-name"><%= folder.title %></span>
      </a>

      <div class="dropdown">
        <button class="btn-icon dropbtn" aria-label="Folder options">
          <i class="fa-solid fa-caret-down"></i>
        </button>
        <div class="dropdown-content">
          <button
            class="dropdown-item"
            popovertarget="folder-dialog-<%= folder.id %>"
          >
            <i class="fa-solid fa-pen-to-square"></i> Edit
          </button>

          <button
            class="dropdown-item"
            popovertarget="share-folder-dialog-<%= folder.id %>"
          >
            <i class="fa-solid fa-share"></i> Share Folder
          </button>
          <form
            action="/folders/<%= folder.id %>/delete/<%= locals.openedFolderId %>"
            method="post"
          >
            <button
              type="submit"
              class="dropdown-item text-danger"
              onclick="
                return confirm(
                  'Are you sure you want to delete this folder and everything it contains?',
                );
              "
            >
              <i class="fa-solid fa-trash"></i> Delete
            </button>
          </form>
        </div>
      </div>
    </div>

    <dialog id="folder-dialog-<%= folder.id %>" class="modal" popover>
      <div class="modal-content">
        <h2 class="modal-title">Rename "<%= folder.title %>"</h2>

        <div class="form-errors"><%- include("errorMessages.ejs") %></div>

        <form
          action="/folders/<%= folder.id %>/update/<%= locals.openedFolderId %>"
          method="post"
        >
          <div class="form-group">
            <label for="folderTitle-<%= folder.id %>">Folder Name</label>
            <input
              id="folderTitle-<%= folder.id %>"
              name="folderTitle"
              type="text"
              value="<%= folder.title %>"
              required
            />
          </div>

          <div class="modal-actions">
            <button
              class="btn btn-outline"
              popovertarget="folder-dialog-<%= folder.id %>"
              popovertargetaction="hide"
              type="button"
            >
              Cancel
            </button>
            <button type="submit" class="btn btn-primary">Save Changes</button>
          </div>
        </form>
      </div>
    </dialog>

    <dialog id="share-folder-dialog-<%= folder.id %>" class="modal" popover>
      <div class="modal-content">
        <h2 class="modal-title">Share "<%= folder.title %>"</h2>
        <p class="text-muted" style="margin-bottom: 1.5rem">
          Choose how long this sharing link will remain active.
        </p>

        <form action="/folders/<%= folder.id %>/share" method="post">
          <div class="form-group">
            <label for="duration-<%= folder.id %>">Link Expiration</label>
            <select
              name="duration"
              id="duration-<%= folder.id %>"
              class="form-select"
            >
              <option value="2m">2 minutes</option>
              <option value="1h">1 hour</option>
              <option value="1d">1 day</option>
              <option value="10d">10 days</option>
            </select>
          </div>

          <div class="modal-actions">
            <button
              class="btn btn-outline"
              popovertarget="share-folder-dialog-<%= folder.id %>"
              popovertargetaction="hide"
              type="button"
            >
              Cancel
            </button>
            <button type="submit" class="btn btn-primary">
              <i class="fa-solid fa-link"></i> Create Link
            </button>
          </div>
        </form>
      </div>
    </dialog>
    <% }); %>
  </div>
  <% } else { %>
  <div class="empty-state">
    <div class="empty-icon"><i class="fa-solid fa-folder"></i></div>
    <p>No folders yet.</p>
  </div>
  <% } %>
</div>
