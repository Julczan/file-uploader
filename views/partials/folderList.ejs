<% if (locals.folders && folders.length !== 0) {%>
<ul>
  <% folders.forEach((folder) => { %>
  <li>
    <a href="/folders/<%= folder.id %>"> <%= folder.title %></a>
    <div>
      <div class="dropdown">
        <i class="fa-solid fa-caret-down dropbtn"></i>
        <div class="dropdown-content">
          <button popovertarget="folder-dialog <%= folder.id %>">
            Update folder
          </button>
          <form
            action="/folders/<%= folder.id %>/delete/<%= locals.openedFolderId %>"
            method="post"
            class="auth-form"
          >
            <button
              type="submit"
              onclick="
                return confirm(
                  'Are you sure you want to delete this folder and everything it contains?',
                );
              "
            >
              Delete
            </button>
          </form>
        </div>
      </div>
    </div>
  </li>
  <dialog id="folder-dialog <%= folder.id %>" popover>
    <div class="form-container">
      <h2 class="form-title">Update <%= folder.title %></h2>
      <div class="form-errors"><%- include("errorMessages.ejs") %></div>
      <form
        action="/folders/<%= folder.id %>/update/<%= locals.openedFolderId %>"
        method="post"
        class="auth-form"
      >
        <div class="form-group">
          <label for="folderTitle">Folder title</label>
          <input
            id="folderTitle"
            name="folderTitle"
            type="text"
            value="<%= folder.title %>"
            required
          />
        </div>
        <button type="submit" class="btn-submit">Update</button>
        <button
          popovertarget="folder-dialog <%= folder.id %>"
          popovertargetaction="hide"
          type="button"
        >
          Close
        </button>
      </form>
    </div>
  </dialog>
  <% }); %>
</ul>

<% }else{ %>
No folders yet
<% } %>
