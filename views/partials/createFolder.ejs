<div class="sidebar-action">
  <button
    class="btn btn-primary btn-block"
    popovertarget="create-folder-dialog"
  >
    <i class="fa-solid fa-plus"></i> New Folder
  </button>

  <dialog id="create-folder-dialog" class="modal" popover>
    <div class="modal-content">
      <h2 class="modal-title">Create New Folder</h2>

      <div class="form-errors"><%- include("errorMessages.ejs") %></div>

      <form action="/folders/create/<%= locals.openedFolderId %>" method="post">
        <div class="form-group">
          <label for="folderTitle">Folder Name</label>
          <input
            id="folderTitle"
            name="folderTitle"
            placeholder="Reports"
            type="text"
            required
          />
        </div>

        <div class="modal-actions">
          <button
            class="btn btn-outline"
            popovertarget="create-folder-dialog"
            popovertargetaction="hide"
            type="button"
          >
            Cancel
          </button>
          <button type="submit" class="btn btn-primary">Create Folder</button>
        </div>
      </form>
    </div>
  </dialog>
</div>
