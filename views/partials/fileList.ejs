<div class="list-section">
  <h3 class="section-title">Files</h3>

  <% if (locals.files && files.length !== 0) { %>
  <div class="file-grid">
    <% files.forEach((file) => { %>
    <div class="file-card">
      <!-- Thumbnail Area -->
      <a href="/files/<%= file.id %>" class="file-thumbnail-link">
        <div class="file-thumbnail">
          <img src="<%= file.imageTag %>" alt="<%= file.name %> preview" />
        </div>
      </a>

      <!-- File Details & Actions -->
      <div class="file-info">
        <a
          href="/files/<%= file.id %>"
          class="file-name"
          title="<%= file.name %>"
        >
          📄 <%= file.name %>
        </a>

        <div class="file-actions">
          <a href="<%= file.url %>" class="btn-icon" title="Download" download>
            ⬇️
          </a>
          <form
            action="/files/<%= file.id %>/delete/<%= locals.openedFolderId %>"
            method="post"
            class="inline-form"
          >
            <button
              type="submit"
              class="btn-icon text-danger"
              title="Delete"
              onclick="
                return confirm('Are you sure you want to delete this file?');
              "
            >
              🗑️
            </button>
          </form>
        </div>
      </div>
    </div>
    <% }); %>
  </div>
  <% } else { %>
  <!-- Reusing the empty state from the folder list -->
  <div class="empty-state">
    <div class="empty-icon">📄</div>
    <p>No files uploaded yet.</p>
  </div>
  <% } %>
</div>
