<% if (locals.files && files.length !== 0) {%>
<ul>
  <% files.forEach((file) => { %>
  <li>
    <img src="<%= file.imageTag %>?v=<%= file.version %>" alt="test" />
    <a href="/files/<%= file.id %>"><%= file.name %></a>
    <a href="<%= file.url %>">Download</a>
    <div>
      <form
        action="/files/<%= file.id %>/delete/<%= locals.openedFolderId %>"
        method="post"
        class="auth-form"
      >
        <button
          type="submit"
          onclick="
            return confirm('Are you sure you want to delete this file?');
          "
        >
          Delete
        </button>
      </form>
    </div>
  </li>
  <% }); %>
</ul>
<% } %>
