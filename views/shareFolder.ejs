<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Share folder - JulczanDrive</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
    <link rel="stylesheet" href="/styles.css" />
    <script
      src="https://kit.fontawesome.com/15a1a718f4.js"
      crossorigin="anonymous"
    ></script>
  </head>
  <body>
    <div class="dashboard">
      <header class="topbar">
        <a href="/" class="logo"
          ><i class="fa-regular fa-cloud"></i> JulczanDrive</a
        >
        <div class="user-menu">
          <% if (locals.currentUser) { %>
          <span class="greeting"
            ><strong><%= currentUser.username %></strong></span
          >
          <% } %>
          <a href="/" class="btn btn-outline" aria-label="home">
            <i class="fa-solid fa-house"></i>
          </a>
        </div>
      </header>

      <main class="dashboard-content">
        <aside class="sidebar">
          <%- include("partials/createFolder.ejs") %> <%-
          include("partials/uploadFile.ejs") %>
        </aside>

        <section class="main-stage">
          <div class="navigation-section">
            <%- include("partials/folderNav.ejs") %>
          </div>

          <div class="share-card">
            <div class="share-header">
              <div class="share-icon">
                <i class="fa-solid fa-link"></i>
              </div>
              <h1 class="modal-title">Share this folder</h1>
              <p class="text-muted">
                Anyone with this link will be able to access the files inside.
              </p>
            </div>

            <div class="copy-link-group">
              <input
                type="text"
                id="shareLink"
                class="share-input"
                value="<%= locals.link %>"
                readonly
              />
              <button class="btn btn-primary" onclick="copyLink()" id="copyBtn">
                <i class="fa-regular fa-copy"></i> Copy
              </button>
            </div>
          </div>
        </section>
      </main>
    </div>

    <%- include("partials/errorDialog.ejs") %>

    <script>
      function copyLink() {
        const linkInput = document.getElementById("shareLink");
        const copyBtn = document.getElementById("copyBtn");

        linkInput.select();
        linkInput.setSelectionRange(0, 99999);
        navigator.clipboard.writeText(linkInput.value).then(() => {
          const originalHTML = copyBtn.innerHTML;
          copyBtn.innerHTML = '<i class="fa-solid fa-check"></i> Copied!';
          copyBtn.style.backgroundColor = "#10b981";

          setTimeout(() => {
            copyBtn.innerHTML = originalHTML;
            copyBtn.style.backgroundColor = "";
          }, 2000);
        });
      }
    </script>
  </body>
</html>
