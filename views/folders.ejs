<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Folder View - MyDrive</title>
    <!-- Modern sans-serif font -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
    <link rel="stylesheet" href="/styles.css" />
    <script
      src="https://kit.fontawesome.com/15a1a718f4.js"
      crossorigin="anonymous"
    ></script>
  </head>
  <body>
    <div class="dashboard">
      <!-- Consistent Top Navigation -->
      <header class="topbar">
        <a href="/" class="logo"
          ><i class="fa-regular fa-cloud"></i> JulczanDrive</a
        >
        <div class="user-menu">
          <% if (locals.currentUser) { %>
          <span class="greeting"
            ><strong><%= currentUser.username %></strong></span
          >
          <% } %>
          <a href="/" class="btn btn-outline" aria-label="home"
            ><i class="fa-solid fa-house"></i
          ></a>
        </div>
      </header>

      <main class="dashboard-content">
        <!-- Sidebar for Actions -->
        <aside class="sidebar">
          <%- include("partials/createFolder.ejs") %> <%-
          include("partials/uploadFile.ejs") %>
        </aside>

        <!-- Main Content Area -->
        <section class="main-stage">
          <!-- Folder Navigation (Breadcrumbs) goes here -->
          <div class="navigation-section">
            <%- include("partials/folderNav.ejs") %>
          </div>

          <!-- Lists -->
          <%- include("partials/folderList.ejs") %>
          <%- include("partials/fileList.ejs") %>
        </section>
      </main>
    </div>

    <!-- Modals/Overlays -->
    <%- include("partials/errorDialog.ejs") %>
  </body>
</html>
