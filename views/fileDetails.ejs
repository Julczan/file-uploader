<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%= locals.file.display_name %> - JulczanDrive</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
    <link rel="stylesheet" href="/styles.css" />
    <script
      src="https://kit.fontawesome.com/15a1a718f4.js"
      crossorigin="anonymous"
    ></script>
  </head>
  <body>
    <header class="topbar">
      <a href="/" class="logo"
        ><i class="fa-regular fa-cloud"></i> JulczanDrive</a
      >
      <div class="user-menu" aria-label="home">
        <a href="/" class="btn btn-outline"
          ><i class="fa-solid fa-house"></i
        ></a>
      </div>
    </header>

    <main class="page-content">
      <% const fileBytes = locals.file.bytes; const fileMegabytes = fileBytes /
      1048576; %>

      <div class="file-details-card">
        <div class="details-preview"><%- locals.imageTag %></div>

        <div class="details-info">
          <h1 class="details-title"><%= locals.file.display_name %></h1>

          <div class="meta-grid">
            <div class="meta-item">
              <span class="meta-label">File Size</span>
              <span class="meta-value"><%= fileMegabytes.toFixed(2) %> MB</span>
            </div>
            <div class="meta-item">
              <span class="meta-label">Date Uploaded</span>
              <span class="meta-value"
                ><%= locals.timeStamp.toLocaleString() %></span
              >
            </div>
          </div>

          <div class="details-actions">
            <a
              href="<%= locals.file.secure_url %>"
              class="btn btn-primary btn-block"
              download
            >
              <i class="fa-solid fa-download"></i> Download File
            </a>
          </div>
        </div>
      </div>
    </main>
  </body>
</html>
