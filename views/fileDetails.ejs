<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="stylesheet" href="/styles.css" />
    <title>Home</title>
  </head>
  <body>
    <main class="app-container">
      <% const fileBytes = locals.file.bytes %> <% const fileMegabytes =
      fileBytes / 1048576 %>
      <a href="<%= locals.file.secure_url %>">Download the file</a>
      <div class="file-details">
        <img src="<%= locals.imageTag %>" alt="test" />
        <div class="detail">File Name: <%= locals.file.display_name %></div>
        <div class="detail">File Size: <%= fileMegabytes.toFixed(3) %> MB</div>
        <div class="detail">
          Upload Time: <%= locals.timeStamp.toLocaleString() %>
        </div>
      </div>
    </main>
  </body>
</html>
