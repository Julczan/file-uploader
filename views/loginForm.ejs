<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Log In - JulczanDrive</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
    <link rel="stylesheet" href="/styles.css" />
    <script
      src="https://kit.fontawesome.com/15a1a718f4.js"
      crossorigin="anonymous"
    ></script>
  </head>
  <body>
    <main class="auth-page">
      <div class="auth-card">
        <div class="auth-header">
          <h2><i class="fa-regular fa-cloud"></i> JulczanDrive</h2>
          <p class="subtitle">Welcome back! Please log in.</p>
        </div>

        <div class="form-errors">
          <%- include("partials/errorMessages.ejs") %>
        </div>

        <form action="/log-in" method="POST">
          <div class="form-group">
            <label for="username">Username</label>
            <input
              id="username"
              name="username"
              placeholder="e.g. coolcoder99"
              type="text"
              required
            />
          </div>

          <div class="form-group">
            <label for="password">Password</label>
            <input
              id="password"
              name="password"
              placeholder="••••••••"
              type="password"
              required
            />
          </div>

          <button type="submit" class="btn btn-primary btn-block">
            Log In
          </button>
        </form>

        <p class="form-footer">
          Don't have an account? <a href="/">Sign up</a>
        </p>
      </div>
    </main>
  </body>
</html>
